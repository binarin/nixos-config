watch_file modules/devshell.nix
# Optional gitignored local settings, such as a workspace's overrides: they may
# append arguments for `use flake` to the bash array use_flake_args, add
# watch_file lines and change PATH.
use_flake_args=()
source_env_if_exists .envrc.local
# nix-direnv keys its cache on the flake alone, so keep the arguments in a
# watched file that changes with them. Otherwise deleting .envrc.local would
# keep the overridden dev shell.
use_flake_args_file="$(direnv_layout_dir)/use-flake-args"
if [[ ! -f $use_flake_args_file || "$(<"$use_flake_args_file")" != "${use_flake_args[*]}" ]]; then
  mkdir -p "$(direnv_layout_dir)"
  printf '%s' "${use_flake_args[*]}" >"$use_flake_args_file"
fi
watch_file "$use_flake_args_file"
use flake . "${use_flake_args[@]}"
